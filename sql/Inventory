-- ============================================
-- INVENTORY MANAGEMENT SUBSYSTEM
-- Module 2: Inventory Management
-- ============================================

-- ============================================
-- 4.1 INVENTORY RECORD MANAGEMENT MODULE
-- ============================================

-- Admin Profile Table (references from other modules)
CREATE TABLE adminProfile (
    accountEmail VARCHAR(100) PRIMARY KEY,
    password VARCHAR(255) NOT NULL
);

-- Product Table
CREATE TABLE Product (
    productID VARCHAR(50) PRIMARY KEY,
    productName VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    stock INT DEFAULT 0,
    price DECIMAL(10,2) DEFAULT 0.00,
    status ENUM('in stock', 'low stock', 'out of stock') DEFAULT 'in stock',
    accountEmail VARCHAR(100),
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- Product Details View (stored as table for UI purposes)
CREATE TABLE productDetails (
    productID VARCHAR(50) PRIMARY KEY,
    productName VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    stock INT DEFAULT 0,
    price DECIMAL(10,2) DEFAULT 0.00,
    statusStock ENUM('in stock', 'low stock', 'out of stock') DEFAULT 'in stock',
    stockListing ENUM('active', 'inactive') DEFAULT 'active',
    productDesc TEXT,
    createdDate TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    lastUpdated TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (productID) REFERENCES Product(productID)
);

-- New Product Entry
CREATE TABLE newProduct (
    productID VARCHAR(50) PRIMARY KEY,
    productName VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    stock INT DEFAULT 0,
    price DECIMAL(10,2) DEFAULT 0.00,
    status ENUM('in stock', 'low stock', 'out of stock') DEFAULT 'in stock',
    productDesc TEXT,
    accountEmail VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- Edit Product Entry
CREATE TABLE editProduct (
    productID VARCHAR(50) PRIMARY KEY,
    productName VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    stock INT DEFAULT 0,
    price DECIMAL(10,2) DEFAULT 0.00,
    status ENUM('in stock', 'low stock', 'out of stock') DEFAULT 'in stock',
    productDesc TEXT,
    accountEmail VARCHAR(100),
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- Delete Product Entry (for logging deleted products)
CREATE TABLE deleteProduct (
    productID VARCHAR(50) PRIMARY KEY,
    productName VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    stock INT DEFAULT 0,
    price DECIMAL(10,2) DEFAULT 0.00,
    status ENUM('in stock', 'low stock', 'out of stock') DEFAULT 'in stock',
    productDesc TEXT,
    deleted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    deleted_by VARCHAR(100),
    FOREIGN KEY (deleted_by) REFERENCES adminProfile(accountEmail)
);

-- ============================================
-- 4.2 STOCK QUANTITY MANAGEMENT MODULE
-- ============================================

-- Materials Table
CREATE TABLE Materials (
    materialID VARCHAR(50) PRIMARY KEY,
    materialName VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    quantity INT DEFAULT 0,
    source VARCHAR(100),
    status ENUM('in stock', 'low stock', 'out of stock') DEFAULT 'in stock',
    accountEmail VARCHAR(100),
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- New Materials Entry
CREATE TABLE newMaterials (
    materialID VARCHAR(50) PRIMARY KEY,
    materialName VARCHAR(100) NOT NULL,
    unit VARCHAR(20),
    category VARCHAR(50),
    quantity INT DEFAULT 0,
    source VARCHAR(100),
    supplier VARCHAR(100),
    remarks TEXT,
    accountEmail VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- Materials Detail
CREATE TABLE materialsDetail (
    materialsID VARCHAR(50) PRIMARY KEY,
    materialName VARCHAR(100) NOT NULL,
    unit VARCHAR(20),
    category VARCHAR(50),
    quantity INT DEFAULT 0,
    lastUpdated TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    supplier VARCHAR(100),
    remarks TEXT,
    source VARCHAR(100),
    storageLocation VARCHAR(100),
    FOREIGN KEY (materialsID) REFERENCES Materials(materialID)
);

-- Stock In (Add Stock)
CREATE TABLE stockIn (
    stockInID INT AUTO_INCREMENT PRIMARY KEY,
    materialsID VARCHAR(50),
    materialName VARCHAR(100) NOT NULL,
    quantityAdded INT DEFAULT 0,
    stockDateAdded TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    source VARCHAR(100),
    remarks TEXT,
    accountEmail VARCHAR(100),
    FOREIGN KEY (materialsID) REFERENCES Materials(materialID),
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- Stock Out (Deduct Stock / Usage)
CREATE TABLE stockOut (
    stockOutID INT AUTO_INCREMENT PRIMARY KEY,
    materialsID VARCHAR(50),
    materialName VARCHAR(100) NOT NULL,
    quantityDeducted INT DEFAULT 0,
    stockDateDeducted TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    usedFor VARCHAR(200),
    remarks TEXT,
    accountEmail VARCHAR(100),
    FOREIGN KEY (materialsID) REFERENCES Materials(materialID),
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- ============================================
-- 4.3 INVENTORY HISTORY TRACKING MODULE
-- ============================================

-- Inventory History (Transaction Log)
CREATE TABLE inventoryHistory (
    TXNID VARCHAR(50) PRIMARY KEY,
    materialsID VARCHAR(50),
    materialName VARCHAR(100) NOT NULL,
    date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    category VARCHAR(50),
    quantityChange INT NOT NULL,
    type ENUM('add', 'deduct', 'update') NOT NULL,
    unit VARCHAR(20),
    sourceOrUsedFor VARCHAR(200),
    recordedBy VARCHAR(100),
    remarks TEXT,
    FOREIGN KEY (materialsID) REFERENCES Materials(materialID),
    FOREIGN KEY (recordedBy) REFERENCES adminProfile(accountEmail)
);

-- Summary Report
CREATE TABLE summaryReport (
    reportID INT AUTO_INCREMENT PRIMARY KEY,
    reportType ENUM('sales report', 'inventory report', 'stock report') NOT NULL,
    startDate TIMESTAMP,
    endDate TIMESTAMP,
    generatedBy VARCHAR(100),
    generatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (generatedBy) REFERENCES adminProfile(accountEmail)
);

-- ============================================
-- 4.4 SUPPLIER AND MATERIAL MONITORING MODULE
-- ============================================

-- Supplier Table
CREATE TABLE supplier (
    supplierID VARCHAR(50) PRIMARY KEY,
    supplierName VARCHAR(100) NOT NULL UNIQUE,
    contactNumber VARCHAR(20),
    email VARCHAR(100),
    suppliedMaterials VARCHAR(200),
    status ENUM('active', 'deactive') DEFAULT 'active',
    accountEmail VARCHAR(100),
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- Supplier Details
CREATE TABLE supplierDetails (
    supplierID VARCHAR(50) PRIMARY KEY,
    supplierName VARCHAR(100) NOT NULL,
    contactNumber VARCHAR(20),
    email VARCHAR(100),
    suppliedMaterials VARCHAR(200),
    status ENUM('active', 'deactive') DEFAULT 'active',
    address TEXT,
    remarks TEXT,
    createdDate TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (supplierID) REFERENCES supplier(supplierID)
);

-- Edit Supplier
CREATE TABLE editSupplier (
    supplierID VARCHAR(50) PRIMARY KEY,
    supplierName VARCHAR(100) NOT NULL,
    contactNumber VARCHAR(20),
    email VARCHAR(100),
    suppliedMaterials VARCHAR(200),
    status ENUM('active', 'deactive') DEFAULT 'active',
    address TEXT,
    remarks TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    accountEmail VARCHAR(100),
    FOREIGN KEY (supplierID) REFERENCES supplier(supplierID),
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- New Supplier
CREATE TABLE newSupplier (
    supplierID VARCHAR(50) PRIMARY KEY,
    supplierName VARCHAR(100) NOT NULL,
    contactNumber VARCHAR(20),
    email VARCHAR(100),
    suppliedMaterials VARCHAR(200),
    status ENUM('active', 'deactive') DEFAULT 'active',
    address TEXT,
    accountEmail VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (accountEmail) REFERENCES adminProfile(accountEmail)
);

-- ============================================
-- TRIGGERS FOR AUTOMATIC UPDATES
-- ============================================

-- Trigger: Update product status based on stock level
DELIMITER //
CREATE TRIGGER update_product_status
BEFORE UPDATE ON Product
FOR EACH ROW
BEGIN
    IF NEW.stock <= 0 THEN
        SET NEW.status = 'out of stock';
    ELSEIF NEW.stock <= 10 THEN
        SET NEW.status = 'low stock';
    ELSE
        SET NEW.status = 'in stock';
    END IF;
END//
DELIMITER ;

-- Trigger: Update material status based on quantity
DELIMITER //
CREATE TRIGGER update_material_status
BEFORE UPDATE ON Materials
FOR EACH ROW
BEGIN
    IF NEW.quantity <= 0 THEN
        SET NEW.status = 'out of stock';
    ELSEIF NEW.quantity <= 10 THEN
        SET NEW.status = 'low stock';
    ELSE
        SET NEW.status = 'in stock';
    END IF;
END//
DELIMITER ;

-- Trigger: Log inventory history when stock is added
DELIMITER //
CREATE TRIGGER log_stock_in
AFTER INSERT ON stockIn
FOR EACH ROW
BEGIN
    INSERT INTO inventoryHistory (
        TXNID, materialsID, materialName, date, category, 
        quantityChange, type, unit, sourceOrUsedFor, recordedBy, remarks
    ) VALUES (
        CONCAT('TXN-', UUID()),
        NEW.materialsID,
        NEW.materialName,
        NEW.stockDateAdded,
        (SELECT category FROM Materials WHERE materialID = NEW.materialsID),
        NEW.quantityAdded,
        'add',
        (SELECT unit FROM materialsDetail WHERE materialsID = NEW.materialsID),
        NEW.source,
        NEW.accountEmail,
        NEW.remarks
    );
    
    -- Update Materials quantity
    UPDATE Materials 
    SET quantity = quantity + NEW.quantityAdded 
    WHERE materialID = NEW.materialsID;
END//
DELIMITER ;

-- Trigger: Log inventory history when stock is deducted
DELIMITER //
CREATE TRIGGER log_stock_out
AFTER INSERT ON stockOut
FOR EACH ROW
BEGIN
    INSERT INTO inventoryHistory (
        TXNID, materialsID, materialName, date, category, 
        quantityChange, type, unit, sourceOrUsedFor, recordedBy, remarks
    ) VALUES (
        CONCAT('TXN-', UUID()),
        NEW.materialsID,
        NEW.materialName,
        NEW.stockDateDeducted,
        (SELECT category FROM Materials WHERE materialID = NEW.materialsID),
        -NEW.quantityDeducted,
        'deduct',
        (SELECT unit FROM materialsDetail WHERE materialsID = NEW.materialsID),
        NEW.usedFor,
        NEW.accountEmail,
        NEW.remarks
    );
    
    -- Update Materials quantity
    UPDATE Materials 
    SET quantity = quantity - NEW.quantityDeducted 
    WHERE materialID = NEW.materialsID;
END//
DELIMITER ;

-- ============================================
-- STORED PROCEDURES
-- ============================================

-- Procedure: Add new product
DELIMITER //
CREATE PROCEDURE addNewProduct(
    IN p_productID VARCHAR(50),
    IN p_productName VARCHAR(100),
    IN p_category VARCHAR(50),
    IN p_stock INT,
    IN p_price DECIMAL(10,2),
    IN p_productDesc TEXT,
    IN p_accountEmail VARCHAR(100)
)
BEGIN
    INSERT INTO Product (productID, productName, category, stock, price, productDesc, accountEmail)
    VALUES (p_productID, p_productName, p_category, p_stock, p_price, p_productDesc, p_accountEmail);
    
    INSERT INTO productDetails (productID, productName, category, stock, price, productDesc)
    VALUES (p_productID, p_productName, p_category, p_stock, p_price, p_productDesc);
    
    INSERT INTO newProduct (productID, productName, category, stock, price, productDesc, accountEmail)
    VALUES (p_productID, p_productName, p_category, p_stock, p_price, p_productDesc, p_accountEmail);
END//
DELIMITER ;

-- Procedure: Add new material
DELIMITER //
CREATE PROCEDURE addNewMaterial(
    IN p_materialID VARCHAR(50),
    IN p_materialName VARCHAR(100),
    IN p_category VARCHAR(50),
    IN p_quantity INT,
    IN p_source VARCHAR(100),
    IN p_supplier VARCHAR(100),
    IN p_unit VARCHAR(20),
    IN p_storageLocation VARCHAR(100),
    IN p_accountEmail VARCHAR(100)
)
BEGIN
    INSERT INTO Materials (materialID, materialName, category, quantity, source, accountEmail)
    VALUES (p_materialID, p_materialName, p_category, p_quantity, p_source, p_accountEmail);
    
    INSERT INTO materialsDetail (materialsID, materialName, category, quantity, supplier, source, unit, storageLocation)
    VALUES (p_materialID, p_materialName, p_category, p_quantity, p_supplier, p_source, p_unit, p_storageLocation);
    
    INSERT INTO newMaterials (materialID, materialName, category, quantity, source, supplier, unit, accountEmail)
    VALUES (p_materialID, p_materialName, p_category, p_quantity, p_source, p_supplier, p_unit, p_accountEmail);
END//
DELIMITER ;

-- Procedure: Get low stock items
DELIMITER //
CREATE PROCEDURE getLowStockItems()
BEGIN
    SELECT materialID, materialName, category, quantity, status
    FROM Materials
    WHERE status = 'low stock' OR status = 'out of stock'
    ORDER BY quantity ASC;
END//
DELIMITER ;

-- Procedure: Generate inventory summary
DELIMITER //
CREATE PROCEDURE generateInventorySummary(
    IN p_reportType VARCHAR(50),
    IN p_startDate TIMESTAMP,
    IN p_endDate TIMESTAMP,
    IN p_accountEmail VARCHAR(100)
)
BEGIN
    -- Insert into summaryReport
    INSERT INTO summaryReport (reportType, startDate, endDate, generatedBy)
    VALUES (p_reportType, p_startDate, p_endDate, p_accountEmail);
    
    -- Return summary data
    SELECT 
        COUNT(DISTINCT productID) as totalProducts,
        SUM(stock) as totalStock,
        AVG(price) as averagePrice,
        COUNT(CASE WHEN status = 'low stock' THEN 1 END) as lowStockCount,
        COUNT(CASE WHEN status = 'out of stock' THEN 1 END) as outOfStockCount
    FROM Product;
END//
DELIMITER ;

